{
    "title": "Palau Government Tenders Scraper (ROP Procurement)",
    "type": "object",
    "schemaVersion": 1,
    "properties": {
        "maxResults": {
            "title": "Max results",
            "type": "integer",
            "description": "Caps how many records are kept in the output for this run. The site publishes one page (no pagination, no separate historical archive) -- everything currently open across all three procurement categories (BHR, CIP, Other Organizations) is returned in a single run.",
            "default": 500,
            "minimum": 1,
            "maximum": 10000,
            "prefill": 500
        },
        "proxyConfiguration": {
            "title": "Proxy configuration",
            "type": "object",
            "editor": "proxy",
            "description": "Apify Proxy configuration.",
            "default": {
                "useApifyProxy": true,
                "apifyProxyGroups": ["RESIDENTIAL"]
            },
            "prefill": {
                "useApifyProxy": true,
                "apifyProxyGroups": ["RESIDENTIAL"]
            }
        }
    }
}
