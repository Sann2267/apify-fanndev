                "fields": [
                    "appName",
                    "voted_up",
                    "review",
                    "playtimeAtReviewHours",
                    "hoursAtReviewTime",
                    "votes_up",
                    "language",
                    "createdAt",
                    "postedDate",
                    "textSentiment",
                    "sentimentMismatch",
                    "reviewUrl",
                    "_error"
