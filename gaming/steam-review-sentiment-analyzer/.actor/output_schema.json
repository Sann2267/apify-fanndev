{
    "actorSpecification": 1,
    "fields": {
        "type": "object",
        "schemaVersion": 1,
        "title": "Steam review & sentiment records",
        "description": "Mixed record types told apart by recordType. REVIEW rows pass Steam's review object through verbatim, so extra upstream fields may appear.",
        "properties": {
            "_input": {
                "title": "Input",
                "description": "The game (app ID / URL / name) or Steam user exactly as given.",
                "type": "string"
            },
            "_source": {
                "title": "Source",
                "description": "Endpoint that produced the record: S1-appreviews, S1-appreviewhistogram, S1-appreviews+histogram, S1-community-html, or none for errors.",
                "type": "string"
            },
            "_scrapedAt": {
                "title": "Scraped at",
                "description": "UTC time the record was produced.",
                "type": "string",
                "format": "date-time"
            },
            "_error": {
                "title": "Error",
                "description": "Only on failed rows: not_found, private_profile, no_reviews, invalid_input, blocked, api_error, exception.",
                "type": "string"
            },
            "_errorDetail": {
                "title": "Error detail",
                "description": "Human-readable reason for the error.",
                "type": "string"
            },
            "recordType": {
                "title": "Record type",
                "description": "SUMMARY, REVIEW, HISTORY, LANGUAGE, USER_REVIEW or ERROR.",
                "type": "string"
            },
            "appId": {
                "title": "App ID",
                "description": "Steam app ID."
            },
            "appName": {
                "title": "Game",
                "description": "Game name from the Steam store."
            },
            "appType": {
                "title": "App type",
                "description": "game, dlc, demo..."
            },
            "storeUrl": {
                "title": "Store URL",
                "description": "Steam store page."
            },
            "resolvedFrom": {
                "title": "Resolved from",
                "description": "appId, url or name (name = first Steam search hit)."
            },
            "appDetailsAvailable": {
                "title": "Store details available",
                "description": "False for delisted/region-locked apps that still have reviews."
            },
            "developers": {
                "title": "Developers",
                "description": ""
            },
            "publishers": {
                "title": "Publishers",
                "description": ""
            },
            "releaseDate": {
                "title": "Release date",
                "description": "As printed by Steam."
            },
            "comingSoon": {
                "title": "Coming soon",
                "description": ""
            },
            "isFree": {
                "title": "Free to play",
                "description": ""
            },
