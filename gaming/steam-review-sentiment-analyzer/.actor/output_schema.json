                "title": "Author",
                "description": "Raw Steam author object: steamid, num_games_owned, num_reviews, playtime_forever / last_two_weeks / at_review (MINUTES), last_played."
            },
            "steam_purchase": {
                "title": "Bought on Steam",
                "description": ""
            },
            "received_for_free": {
                "title": "Received for free",
                "description": ""
            },
            "refunded": {
                "title": "Refunded",
                "description": ""
