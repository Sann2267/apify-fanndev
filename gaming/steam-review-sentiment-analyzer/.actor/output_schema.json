                "title": "Price",
                "description": "Formatted price in the chosen store country."
            },
            "priceCurrency": {
                "title": "Currency",
                "description": ""
            },
            "discountPercent": {
                "title": "Discount %",
                "description": ""
            },
            "genres": {
                "title": "Genres",
                "description": ""
            },
            "metacriticScore": {
                "title": "Metacritic score",
                "description": ""
            },
            "storeRecommendationsTotal": {
                "title": "Store recommendation count",
                "description": "appdetails' own counter (differs slightly from review totals)."
            },
            "steamScore": {
                "title": "Steam score",
                "description": "Official store score: Steam purchases, all languages (review_score, review_score_desc, totals, positiveRatio)."
            },
            "allPurchasesScore": {
                "title": "All purchases score",
                "description": "Same totals including key activations (purchase_type=all)."
