    "views": {
        "overview": {
            "title": "Sentiment summary",
            "description": "One row per game (summary mode).",
            "transformation": {
                "fields": [
                    "appName",
                    "appId",
                    "steamScore",
                    "allPurchasesScore",
                    "trend",
                    "reviewBombCandidates",
                    "languageBreakdown",
                    "complaintAnalysis",
                    "price",
                    "releaseDate",
                    "_error"
                ]
            },
            "display": {
                "component": "table"
            }
        },
        "reviews": {
            "title": "Reviews",
            "description": "reviews and userReviews modes.",
